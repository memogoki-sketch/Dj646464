{
  "name": "dj64-windows",
  "productName": "DJ64",
  "version": "1.2.0",
  "description": "DJ64 IPTV Player für Windows",
  "main": "main.js",
  "author": "DJ64",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "hls.js": "1.5.15",
    "mpegts.js": "1.7.3"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "de.dj64.desktop",
    "productName": "DJ64",
    "artifactName": "DJ64-Windows.exe",
    "compression": "maximum",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "node_modules/hls.js/dist/hls.min.js",
      "node_modules/mpegts.js/dist/mpegts.js",
      "package.json"
    ],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    }
  }
}
